# ──────────────────────────────────────────────────────────────────
# Al Safwa Trading — environment template
# Copy to .env.local for local development. NEVER commit real keys.
# ──────────────────────────────────────────────────────────────────

# Supabase (backend integration phase) — frontend-safe keys ONLY.
# VITE_SUPABASE_PUBLISHABLE_KEY is the newer name for the anon key; either works.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public site URL — used for canonical tags and the sitemap
VITE_SITE_URL=https://alsafwaoman.com

# IMPORTANT — never commit:
#   * Supabase service-role keys
#   * database passwords
#   * private credentials
#   * customer information
