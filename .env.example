# Supabase (backend integration phase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL — used for canonical tags and the sitemap
VITE_SITE_URL=https://alsafwa-trading.example

# IMPORTANT — never commit:
#   * Supabase service-role keys
#   * database passwords
#   * private credentials
#   * customer information
